{
  "name": "frantoken",
  "version": "1.0.0",
  "description": "Tokenizacion de franquicias con ERC-3643 (T-REX)",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "node": "hardhat node",
    "besu:up": "docker compose -f infra/besu/docker-compose.yml up -d",
    "besu:down": "docker compose -f infra/besu/docker-compose.yml down",
    "besu:reset": "docker compose -f infra/besu/docker-compose.yml down -v",
    "besu:logs": "docker compose -f infra/besu/docker-compose.yml logs -f",
    "besu:status": "node scripts/besu-status.js",
    "deploy:besu": "hardhat run scripts/deploy.js --network besu",
    "deploy:academic": "hardhat run scripts/deploy-academic.js --network localhost"
  },
